# Docker Compose / VPS settings.
# Copy to .env in the project root before running docker compose.

POSTGRES_DB=shamrai
POSTGRES_USER=shamrai
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Preview port exposed by the frontend nginx container.
# Use 80 only for an explicit public production cutover.
FRONTEND_PORT=8082

# Keep empty for same-origin nginx proxy (/api). Set only if frontend must call a separate API origin.
VITE_API_URL=

# Production default is cookie-only. Set true only for temporary bearer/debug compatibility.
VITE_ENABLE_BEARER_AUTH_COMPAT=false
ENABLE_BEARER_AUTH_COMPAT=false

# Optional VK ID frontend build args for onboarding/profile linking and browser login.
VITE_VK_ID_APP_ID=
VITE_VK_ID_REDIRECT_URI=https://shamra1.pro
VITE_VK_GROUP_ID=
VITE_TELEGRAM_BOT_USERNAME=Shamra1_bot
TELEGRAM_BOT_USERNAME=Shamra1_bot
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# Optional Plausible Analytics. Leave empty to disable tracking in this build.
VITE_PLAUSIBLE_DOMAIN=
# Cloud default is https://plausible.io/api/event. For self-hosted use https://analytics.example.com/api/event.
VITE_PLAUSIBLE_ENDPOINT=
VITE_PLAUSIBLE_CAPTURE_LOCALHOST=false

# Web Push / PWA. Do not commit real private keys.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@shamra1.pro

# Non-secret backup trust anchor used by operator scripts and restore drills.
# Base64 must encode the exact 44-byte Ed25519 SubjectPublicKeyInfo DER value.
# The private signing key is generated only on the VDS and has no env/config input.
SHAMRAI_BACKUP_MANIFEST_SIGNING_PUBLIC_KEY_BASE64=replace-with-base64-ed25519-spki-der
