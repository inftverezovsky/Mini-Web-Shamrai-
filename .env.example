# Docker Compose / VPS settings.
# Copy to .env in the project root before running docker compose.

POSTGRES_DB=shamrai
POSTGRES_USER=shamrai
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Preview port exposed by the frontend nginx container.
# Use 80 only for an explicit public production cutover.
FRONTEND_PORT=8082

# Keep empty for same-origin nginx proxy (/api). Set only if frontend must call a separate API origin.
VITE_API_URL=
