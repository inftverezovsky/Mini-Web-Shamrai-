# Build Stage
FROM node:24.15.0-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS build

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Copy source and build
COPY . .
ARG VITE_API_URL
ARG VITE_ENABLE_DEBUG_AUTH=false
ARG VITE_ENABLE_BEARER_AUTH_COMPAT=false
ARG VITE_VK_ID_APP_ID
ARG VITE_VK_ID_REDIRECT_URI
ARG VITE_VK_GROUP_ID
ARG VITE_TELEGRAM_BOT_USERNAME
ARG VITE_WEB_PUSH_VAPID_PUBLIC_KEY
ARG VITE_PLAUSIBLE_DOMAIN
ARG VITE_PLAUSIBLE_ENDPOINT
ARG VITE_PLAUSIBLE_CAPTURE_LOCALHOST=false
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_ENABLE_DEBUG_AUTH=${VITE_ENABLE_DEBUG_AUTH}
ENV VITE_ENABLE_BEARER_AUTH_COMPAT=${VITE_ENABLE_BEARER_AUTH_COMPAT}
ENV VITE_VK_ID_APP_ID=${VITE_VK_ID_APP_ID}
ENV VITE_VK_ID_REDIRECT_URI=${VITE_VK_ID_REDIRECT_URI}
ENV VITE_VK_GROUP_ID=${VITE_VK_GROUP_ID}
ENV VITE_TELEGRAM_BOT_USERNAME=${VITE_TELEGRAM_BOT_USERNAME}
ENV VITE_WEB_PUSH_VAPID_PUBLIC_KEY=${VITE_WEB_PUSH_VAPID_PUBLIC_KEY}
ENV VITE_PLAUSIBLE_DOMAIN=${VITE_PLAUSIBLE_DOMAIN}
ENV VITE_PLAUSIBLE_ENDPOINT=${VITE_PLAUSIBLE_ENDPOINT}
ENV VITE_PLAUSIBLE_CAPTURE_LOCALHOST=${VITE_PLAUSIBLE_CAPTURE_LOCALHOST}
RUN npm run build

# Nginx Stage for production deployment
FROM nginx:stable-alpine@sha256:8a4f4b94275ff59d809477799cbbaf1a7ab65ed1871403d05e31fd66bdb8db82

COPY --from=build /app/dist /usr/share/nginx/html

# Custom nginx config to handle React SPA router redirects
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN touch /run/nginx.pid \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d \
    && chown nginx:nginx /run/nginx.pid

EXPOSE 8080

USER nginx

CMD ["nginx", "-g", "daemon off;"]
