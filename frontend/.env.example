# Leave empty in production Docker/nginx deployments so the app uses same-origin /api.
# Use http://localhost:8000 for local Vite development if backend runs outside nginx.
VITE_API_URL=

# Local browser-only debug auth and mock API. It is ignored by production build code paths.
VITE_ENABLE_DEBUG_AUTH=false

# Optional VK ID app config for onboarding profile linking.
VITE_VK_ID_APP_ID=
VITE_VK_ID_REDIRECT_URI=https://shamra1.pro
VITE_VK_GROUP_ID=

# Browser Telegram bot username for open/login buttons, without @.
VITE_TELEGRAM_BOT_USERNAME=Shamra1_bot

# Optional fallback. The app also fetches the public key from /api/signals/web-push/public-key.
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
