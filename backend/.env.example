# Runtime mode: use local for development, production for VPS.
APP_ENV=local

# Local example. In docker-compose production this is overridden from the root .env Postgres values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shamrai

# Telegram bot / Mini App.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Shamra1_bot
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_SHAMRAI_CUSTOM_EMOJI_ID=
TELEGRAM_WRITE_CUSTOM_EMOJI_ID=
TELEGRAM_BOOKMAKER_CUSTOM_EMOJI_IDS=
TELEGRAM_SPORT_CUSTOM_EMOJI_IDS=
TELEGRAM_API_TIMEOUT_SECONDS=3.0
TELEGRAM_API_RETRIES=2
TELEGRAM_START_RESPONSE_TIMEOUT_SECONDS=4.0
TELEGRAM_BROADCAST_CONCURRENCY=12
TELEGRAM_USE_POLLING=false
# Optional fixed public IP for Telegram webhook registration, useful when Telegram keeps a stale route.
TELEGRAM_WEBHOOK_IP_ADDRESS=
# If SALES_MANAGER_TELEGRAM_ID is empty, OWNER_TELEGRAM_ID receives private forecast requests.
SALES_MANAGER_TELEGRAM_ID=
# Optional Telegram group/chat where Shamrai admins receive forecast requests and result summaries.
TELEGRAM_ADMIN_GROUP_CHAT_ID=
# Optional: receives completed welcome quiz reports in a private chat or group.
SHAMRAI_ONBOARDING_REPORT_CHAT_ID=
OWNER_TELEGRAM_ID=

# VK ID OAuth for optional onboarding profile linking.
VK_ID_APP_ID=
VK_ID_REDIRECT_URI=https://shamra1.pro
VK_ID_CLIENT_SECRET=
# VK community delivery. Keep real token/secret values only in runtime env.
VK_GROUP_ID=
VK_GROUP_ACCESS_TOKEN=
VK_CALLBACK_CONFIRMATION_CODE=
VK_CALLBACK_SECRET=
VK_API_VERSION=5.199
VK_BROADCAST_CONCURRENCY=8
VK_DIALOG_POLLING_ENABLED=false
VK_DIALOG_POLLING_INTERVAL_SECONDS=4.0
VK_DIALOG_POLLING_BATCH_SIZE=20

# Web Push / PWA. Keep the private key only in runtime env.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@shamra1.pro

# Debug flags. Must stay false in production.
DEBUG_MODE=false
ALLOW_DEBUG_AUTH_BYPASS=false

# At least 32 random characters in production.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=https://shamra1.pro,https://www.shamra1.pro
ENABLE_BACKGROUND_TASKS=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=true
REDIS_HOT_CACHE_TTL_SECONDS=300
DELIVERY_OUTBOX_BATCH_SIZE=50
DELIVERY_OUTBOX_IDLE_SECONDS=5
DELIVERY_OUTBOX_DEFAULT_CONCURRENCY=2
DELIVERY_OUTBOX_CHANNEL_CONCURRENCY=telegram_message=3,vk_message=2,web_push_signal=5,forecast_auto_delivery=1,forecast_full_delivery=1
TELEGRAM_VIP_CHAT_ID=
API_BASE_URL=https://shamra1.pro
FRONTEND_BASE_URL=https://shamra1.pro/app

# Configure at least one ruble payment provider for production subscription payments.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://shamra1.pro/app
TEGRO_SHOP_ID=
TEGRO_API_KEY=
TEGRO_SECRET_KEY=
TEGRO_RETURN_URL=https://shamra1.pro/app
TEGRO_API_BASE_URL=https://tegro.money/api

# Optional network proxy for Telegram API calls.
HTTPS_PROXY=

# Free security hardening. Production must use enforce.
SECURITY_RATE_LIMIT_MODE=enforce
SECURITY_RATE_LIMIT_STORAGE=auto
SECURITY_RATE_LIMIT_REDIS_PREFIX=security:rate-limit:v1
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_GROUP_RULES=public_read=120:40,auth=20:10,payment=30:10,webhook=120:60,admin=60:20,upload=20:5,default=180:60
SECURITY_RATE_LIMIT_MAX_TRACKED_KEYS=10000
SECURITY_RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
SECURITY_JSON_BODY_MAX_BYTES=1048576
SECURITY_UPLOAD_BODY_MAX_BYTES=10485760

# Stats export. Keep service account JSON only in runtime env, base64-encoded.
STATS_EXPORT_UNIT_STAKE_RUB=10000
GOOGLE_DRIVE_STATS_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=auto
GOOGLE_DRIVE_STATS_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Extra password required to reveal integration secrets in the admin settings UI.
# Real value belongs only in backend/.env or deployment secrets, never in git.
ADMIN_INTEGRATIONS_PASSWORD=

# Observability. These are non-secret thresholds and logging controls.
ADMIN_MONITORING_LOG_PATH=
OBSERVABILITY_LOG_FORMAT=json
OBSERVABILITY_ALERT_INTERVAL_SECONDS=60
OBSERVABILITY_ALERT_LOG_COOLDOWN_SECONDS=300
OBSERVABILITY_OUTBOX_QUEUE_WARNING=50
OBSERVABILITY_OUTBOX_QUEUE_CRITICAL=100
OBSERVABILITY_OUTBOX_OLDEST_PENDING_WARNING_SECONDS=600
OBSERVABILITY_OUTBOX_OLDEST_PENDING_CRITICAL_SECONDS=1800
OBSERVABILITY_OUTBOX_RETRY_RATE_WARNING=20
OBSERVABILITY_OUTBOX_RETRY_RATE_CRITICAL=40
OBSERVABILITY_OUTBOX_FAIL_RATE_WARNING=5
OBSERVABILITY_OUTBOX_FAIL_RATE_CRITICAL=10
OBSERVABILITY_5XX_WARNING_MINUTES=3
OBSERVABILITY_5XX_CRITICAL_MINUTES=5
OBSERVABILITY_INTEGRATION_FAILURE_CONSECUTIVE=3
OBSERVABILITY_PAYMENT_MISMATCH_WINDOW_SECONDS=600
OBSERVABILITY_PAYMENT_MISMATCH_CRITICAL_COUNT=3
